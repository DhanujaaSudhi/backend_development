{
	"info": {
		"_postman_id": "12345678-1234-1234-1234-1234567890ab",
		"name": "esysflow Core Employee Hub",
		"description": "API for managing employee authentication and records. Base URLs:\nDev: http://localhost:8000\nStaging: https://api.staging.esysflow.com\n\nAuth Flow: Verify Employee (get OTP) -> Verify OTP (get token logic) -> Create Password (using token).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "1. Verify Employee",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"employee_id\": \"EMP100\",\n    \"verification_method\": \"email\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/verify-employee",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"verify-employee"
							]
						}
					},
					"response": []
				},
                {
					"name": "1. Verify Employee (Error State)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"employee_id\": \"INVALID\",\n    \"verification_method\": \"email\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/verify-employee",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"verify-employee"
							]
						}
					},
					"response": []
				},
				{
					"name": "2. Verify OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"employee_id\": \"EMP100\",\n    \"otp\": \"12345\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/verify-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"verify-otp"
							]
						}
					},
					"response": []
				},
				{
					"name": "3. Create Password",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"employee_id\": \"EMP100\",\n    \"password\": \"SecurePass123!\",\n    \"confirm_password\": \"SecurePass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/create-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"create-password"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Employees",
			"item": [
				{
					"name": "Get Employees (Pagination & Empty List demo)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/employees?page=1&size=10&role=Admin",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"employees"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "size",
									"value": "10"
								},
								{
									"key": "role",
									"value": "Admin"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Employee Details (Long name demo)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/employees/EMP100",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"employees",
								"EMP100"
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Employee Role",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"role\": \"SuperAdmin\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/employees/EMP100/role",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"employees",
								"EMP100",
								"role"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "mock_jwt_token",
			"type": "string"
		}
	]
}
